<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Ingress Anomaly</title>
  <style>
    :root {
      --bg-dark: #0f141c;
      --card-bg: #141c28;
      --card-border: #223247;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --enl-color: #00ea62;
      --res-color: #00a2ff;
      --accent: #2dd4bf;
    }
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.5;
    }
    .top-nav {
      max-width: 1000px;
      margin: 1.5rem auto 0;
      padding: 0 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .nav-link {
      color: var(--accent);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
    }
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 1.5rem;
    }
    h1 {
      font-size: 2.2rem;
      margin-bottom: 1rem;
    }
    h2 {
      font-size: 1.5rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 0.5rem;
    }
    h3 {
      font-size: 1.25rem;
      margin-top: 2rem;
      margin-bottom: 0.5rem;
    }
    .status-box {
      background: var(--card-bg);
      border-left: 4px solid var(--accent);
      border-radius: 4px 8px 8px 4px;
      padding: 1rem 1.25rem;
      margin-bottom: 2rem;
    }
    .status-box p {
      margin: 0.25rem 0;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0 2rem;
      background: var(--card-bg);
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--card-border);
    }
    th, td {
      padding: 0.75rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--card-border);
    }
    th:first-child, td:first-child {
      text-align: left;
    }
    th {
      background: rgba(255, 255, 255, 0.03);
      color: var(--text-muted);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    tr.total-row {
      font-weight: bold;
      background: rgba(255, 255, 255, 0.05);
      border-top: 2px solid var(--card-border);
    }
    td a {
      color: var(--accent);
      text-decoration: none;
    }
    td a:hover {
      text-decoration: underline;
    }
    .site-total {
      font-size: 1rem;
      margin: 0.5rem 0 1rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="top-nav">
    <a class="nav-link" href="{{ t.switch_url }}">{{ t.back }}</a>
    <a class="nav-link" href="{{ official_url }}" target="_blank" rel="noopener">{{ t.official_article }}</a>
  </div>

  <main class="container">
    <h1>{{ season_title }}</h1>

    <div class="status-box">
      <p><strong>Statut global :</strong> {{ global_status }}</p>
      <p><small>{{ t.last_update }} : <time datetime="{{ updated_at }}">{{ updated_at }}</time></small></p>
    </div>

    <h2>{{ t.season_overview }}</h2>
    <table>
      <thead>
        <tr>
          <th>{{ t.col_event }}</th>
          <th>{{ t.col_enl }}</th>
          <th>{{ t.col_res }}</th>
          <th>{{ t.col_winner }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in season_overview %}
        <tr>
          <td><a href="{{ row.link }}"><strong>{{ row.name }}</strong></a></td>
          <td>{{ row.enl }}</td>
          <td>{{ row.res }}</td>
          <td>{{ row.winner }}</td>
        </tr>
        {% endfor %}
        <tr class="total-row">
          <td>{{ t.total_partial }}</td>
          <td>{{ enl_total }}</td>
          <td>{{ res_total }}</td>
          <td>
            {% if diff > 0 %}
              🔵 RES (+{{ diff }})
            {% elif diff < 0 %}
              🟢 ENL (+{{ -diff }})
            {% else %}
              {{ t.tie }}
            {% endif %}
          </td>
        </tr>
      </tbody>
    </table>

    {% if sites and sites|length > 0 %}
    <h2>{{ t.city_results }}</h2>
    {% for site in sites %}
    <div id="{{ site.name | lower | replace(' ', '-') }}">
      <h3>📍 {{ site.name }}</h3>
      <div class="site-total">{{ t.total_site }} : 🟢 <strong>{{ site.enl_pts }}</strong> — 🔵 <strong>{{ site.res_pts }}</strong></div>
      <table>
        <thead>
          <tr>
            <th>{{ t.col_category }}</th>
            <th>{{ t.col_enl }}</th>
            <th>{{ t.col_res }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>🥷 Stealth Ops</td>
            <td>{{ site.stealth_ops.enl }}</td>
            <td>{{ site.stealth_ops.res }}</td>
          </tr>
          <tr>
            <td>🏙️ Urban Ops</td>
            <td>{{ site.urban_ops.enl }}</td>
            <td>{{ site.urban_ops.res }}</td>
          </tr>
          <tr>
            <td>💎 Shard Battle</td>
            <td>{{ site.shards.enl }}</td>
            <td>{{ site.shards.res }}</td>
          </tr>
          <tr>
            <td>📡 Beacon Battle</td>
            <td>{{ site.beacons.enl }}</td>
            <td>{{ site.beacons.res }}</td>
          </tr>
          <tr>
            <td>🧭 Anomaly Uniques</td>
            <td>{{ site.uniques.enl }}</td>
            <td>{{ site.uniques.res }}</td>
          </tr>
        </tbody>
      </table>
    </div>
    {% endfor %}
    {% endif %}

    {% if global_ops and global_ops|length > 0 %}
    <div id="section-global-ops">
      <h2>🌐 {{ t.global_ops_title }}</h2>
      <table>
        <thead>
          <tr>
            <th>{{ t.col_event }}</th>
            <th>{{ t.col_enl }}</th>
            <th>{{ t.col_res }}</th>
          </tr>
        </thead>
        <tbody>
          {% for op in global_ops %}
          <tr>
            <td>{{ op.event }}</td>
            <td>{{ op.enl }}</td>
            <td>{{ op.res }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if ifs and ifs|length > 0 %}
    <div id="section-ifs">
      <h2>☕ {{ t.ifs_title }}</h2>
      <table>
        <thead>
          <tr>
            <th>Phase / Mois</th>
            <th>{{ t.col_enl }}</th>
            <th>{{ t.col_res }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in ifs %}
          <tr>
            <td><strong>{{ item.phase }}</strong></td>
            <td>{{ item.enl }}</td>
            <td>{{ item.res }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </main>
</body>
</html>
