<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <style>
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0b0f19;
      color: #e2e8f0;
      line-height: 1.6;
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
      position: relative;
    }
    .top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      gap: 1rem;
    }
    .nav-left {
      display: flex;
      align-items: center;
    }
    .nav-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    a.back {
      color: #00bbff;
      text-decoration: none;
      font-weight: 500;
    }
    a.back:hover { text-decoration: underline; }
    .nav-btn {
      color: #e2e8f0;
      text-decoration: none;
      font-size: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 5px 12px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.04);
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .nav-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: #00bbff;
      color: #ffffff;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      background: #141c2e;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    th, td {
      padding: 10px 14px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    th {
      background: #1b263b;
      color: #94a3b8;
      font-weight: 600;
    }
    tr:last-child td { border-bottom: none; }
    table a {
      color: #38bdf8;
      text-decoration: none;
      border-bottom: 1px dashed rgba(56, 189, 248, 0.4);
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    table a:hover {
      color: #7dd3fc;
      border-bottom-style: solid;
    }
    .site-section {
      scroll-margin-top: 1.5rem;
    }
    blockquote {
      border-left: 4px solid #00bbff;
      background: rgba(0, 187, 255, 0.08);
      margin: 1rem 0;
      padding: 0.8rem 1.2rem;
      border-radius: 0 8px 8px 0;
    }
    hr { border: 0; height: 1px; background: rgba(255,255,255,0.1); margin: 2.5rem 0; }

    /* Lignes en attente / en direct */
    tr.row-pending {
      background: rgba(239, 68, 68, 0.12) !important;
    }
    tr.row-pending td {
      border-top: 1px solid rgba(239, 68, 68, 0.4);
      border-bottom: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
    }
    tr.row-pending td:first-child {
      border-left: 3px solid #ef4444;
    }
    tr.row-pending td:last-child {
      border-right: 1px solid rgba(239, 68, 68, 0.4);
    }
    tr.row-pending a {
      color: #f87171 !important;
      border-bottom-color: rgba(239, 68, 68, 0.6) !important;
    }

    /* Badge clignotant LIVE */
    .badge-pending-mini {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      padding: 1px 6px;
      margin-left: 6px;
      border-radius: 4px;
      background: #ef4444;
      color: #ffffff;
      vertical-align: middle;
      animation: pulse-badge 2s infinite;
    }

    @keyframes pulse-badge {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(0.96); }
      100% { opacity: 1; transform: scale(1); }
    }

    /* Ligne Total final */
    tr.row-total td {
      background: rgba(255, 255, 255, 0.04);
      font-weight: bold;
      border-top: 2px solid rgba(255, 255, 255, 0.15);
    }

    /* Bouton flottant retour en haut */
    #btn-back-to-top {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #1e293b;
      color: #38bdf8;
      border: 1px solid #334155;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
      z-index: 100;
    }
    #btn-back-to-top.visible {
      opacity: 1;
      visibility: visible;
    }
    #btn-back-to-top:hover {
      background: #00bbff;
      color: #0b0f19;
      border-color: #00bbff;
      transform: translateY(-3px);
    }
  </style>
</head>
<body>
  <div id="page-top"></div>

  <div class="top-nav">
    <div class="nav-left">
      <a href="index.html" class="back">{{ t.back }}</a>
    </div>
    <div class="nav-right">
      {% if official_url %}
      <a href="{{ official_url }}" target="_blank" rel="noopener noreferrer" class="nav-btn">
        {{ t.official_article }} ↗
      </a>
      {% endif %}
      <a href="{{ t.switch_url }}{{ slug }}.html" class="nav-btn">{{ t.switch_label }}</a>
    </div>
  </div>

  {{ content }}

  <!-- Bouton de retour en haut -->
  <button id="btn-back-to-top" title="Haut de page" aria-label="Haut de page">↑</button>

  <script>
    // 1. Formatage de toutes les balises <time class="local-date">
    document.querySelectorAll('.local-date').forEach(el => {
      const isoString = el.getAttribute('datetime') || el.textContent.trim();
      if (isoString) {
        const date = new Date(isoString);
        if (!isNaN(date.getTime())) {
          el.textContent = date.toLocaleString('{{ t.lang_code }}', {
            dateStyle: 'short',
            timeStyle: 'medium'
          });
        }
      }
    });

    // 2. Gestion du bouton retour en haut
    const btnTop = document.getElementById('btn-back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        btnTop.classList.add('visible');
      } else {
        btnTop.classList.remove('visible');
      }
    });

    btnTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // Nettoie l'ancre dans l'URL sans recharger la page
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    });

    // 3. Forcer le démarrage en haut de page lors d'un rechargement (F5)
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.addEventListener('load', () => {
      if (window.performance && performance.navigation && performance.navigation.type === 1) {
        // En cas de F5 / Reload, on revient en haut et on retire l'ancre
        window.scrollTo(0, 0);
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
    });
  </script>
</body>
</html>
