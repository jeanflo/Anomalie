<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t.hub_title }}</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: #141c2e;
      --border: rgba(255, 255, 255, 0.08);
      --res-blue: #00bbff;
      --enl-green: #00e676;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 2rem 1.5rem;
    }
    .top-bar {
      max-width: 1200px;
      margin: 0 auto 1.5rem auto;
      display: flex;
      justify-content: flex-end;
    }
    .lang-btn {
      color: var(--text);
      text-decoration: none;
      font-size: 0.85rem;
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.04);
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .lang-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--res-blue);
    }
    header {
      text-align: center;
      margin-bottom: 3rem;
    }
    header h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin: 0 0 0.5rem 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    }

    /* Style distinctif de l'anomalie en cours */
    .card-active {
      border: 2px solid var(--res-blue);
      box-shadow: 0 0 20px rgba(0, 187, 255, 0.25);
    }
    .card-active:hover {
      box-shadow: 0 0 32px rgba(0, 187, 255, 0.45);
    }

    /* Badge rouge clignotant En Direct / Live */
    .live-indicator {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(11, 15, 25, 0.88);
      backdrop-filter: blur(4px);
      color: #ff3344;
      border: 1px solid rgba(255, 51, 68, 0.6);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.8px;
      padding: 4px 10px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5);
      z-index: 2;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #ff3344;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 51, 68, 0.7); }
      70% { transform: scale(1.1); box-shadow: 0 0 0 7px rgba(255, 51, 68, 0); }
      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 51, 68, 0); }
    }

    .banner-wrapper {
      position: relative;
      width: 100%;
      height: 180px;
      background-color: #000;
    }
    .banner {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .content {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-res { background: rgba(0, 187, 255, 0.15); color: var(--res-blue); border: 1px solid var(--res-blue); }
    .badge-enl { background: rgba(0, 230, 118, 0.15); color: var(--enl-green); border: 1px solid var(--enl-green); }
    .title {
      font-size: 1.25rem;
      margin: 0 0 1.2rem 0;
    }
    .scores {
      display: flex;
      justify-content: space-between;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
    }
    .score-enl { color: var(--enl-green); font-weight: bold; }
    .score-res { color: var(--res-blue); font-weight: bold; }
    footer {
      text-align: center;
      margin-top: 4rem;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <a href="{{ t.switch_url }}" class="lang-btn">{{ t.switch_label }}</a>
  </div>

  <header>
    <h1>{{ t.hub_title }}</h1>
    <p style="color: var(--text-muted);">{{ t.hub_subtitle }}</p>
  </header>

  <main class="grid">
    {% for s in seasons %}
    <a href="{{ s.html_file }}" class="card {% if s.is_active %}card-active{% endif %}">
      <div class="banner-wrapper">
        {% if s.is_active %}
        <div class="live-indicator">
          <div class="pulse-dot"></div>
          <span>{{ t.badge_live }}</span>
        </div>
        {% endif %}
        <img src="{{ s.banner }}" alt="{{ s.title }}" class="banner" onerror="this.src='https://placehold.co/600x300/141c2e/FFF?text=Anomaly'">
      </div>
      
      <div class="content">
        <div>
          <span class="badge {{ s.badge_class }}">{{ s.lead_badge }}</span>
          <h2 class="title">{{ s.title }}</h2>
        </div>
        <div class="scores">
          <div>🟢 ENL : <span class="score-enl">{{ s.enl }}</span></div>
          <div>🔵 RES : <span class="score-res">{{ s.res }}</span></div>
        </div>
      </div>
    </a>
    {% endfor %}
  </main>

  <footer>
    {{ t.last_update }} <time id="last-update" datetime="{{ updated_at }}">{{ updated_at }}</time>
  </footer>

  <script>
    (function() {
      const timeElem = document.getElementById('last-update');
      if (timeElem && timeElem.dateTime) {
        const date = new Date(timeElem.dateTime);
        timeElem.textContent = date.toLocaleString('{{ t.lang_code }}', {
          dateStyle: 'short',
          timeStyle: 'medium'
        });
      }
    })();
  </script>

</body>
</html>
