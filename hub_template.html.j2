<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t.hub_title }}</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: #141c2e;
      --border: rgba(255, 255, 255, 0.08);
      --res-blue: #00bbff;
      --enl-green: #00e676;
      --warn-yellow: #ffb703;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 2rem 1.5rem;
    }
    .top-bar {
      max-width: 1200px;
      margin: 0 auto 1.5rem auto;
      display: flex;
      justify-content: flex-end;
    }
    .lang-btn {
      color: var(--text);
      text-decoration: none;
      font-size: 0.85rem;
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.04);
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .lang-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--res-blue);
    }
    header {
      text-align: center;
      margin-bottom: 2rem;
    }
    header h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin: 0 0 0.5rem 0;
    }

    /* Bandeau palmarès global */
    .standings-banner {
      max-width: 760px;
      margin: 0 auto 3rem auto;
      background: linear-gradient(180deg, #141c2e 0%, #0e1524 100%);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.2rem 1.6rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }
    .standings-title {
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.9rem;
    }
    .standings-counts {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.8rem;
    }
    .faction-stat {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .stat-num {
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1;
    }
    .stat-label {
      font-size: 0.88rem;
      font-weight: 600;
    }
    .stat-enl { color: var(--enl-green); }
    .stat-res { color: var(--res-blue); }
    .stat-tie {
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    /* Jauge comparative bicolore */
    .ratio-bar {
      height: 8px;
      width: 100%;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 999px;
      overflow: hidden;
      display: flex;
      gap: 2px;
    }
    .bar-segment-enl {
      height: 100%;
      background: var(--enl-green);
      box-shadow: 0 0 10px rgba(0, 230, 118, 0.5);
      transition: width 0.6s ease;
    }
    .bar-segment-res {
      height: 100%;
      background: var(--res-blue);
      box-shadow: 0 0 10px rgba(0, 187, 255, 0.5);
      transition: width 0.6s ease;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    }

    .card-live {
      border: 2px solid var(--res-blue);
      box-shadow: 0 0 22px rgba(0, 187, 255, 0.25);
    }
    .card-live:hover {
      box-shadow: 0 0 32px rgba(0, 187, 255, 0.45);
    }

    .card-upcoming {
      border: 1px dashed var(--warn-yellow);
      box-shadow: 0 0 16px rgba(255, 183, 3, 0.15);
    }
    .card-upcoming:hover {
      box-shadow: 0 0 24px rgba(255, 183, 3, 0.35);
    }

    .banner-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(11, 15, 25, 0.88);
      backdrop-filter: blur(4px);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.8px;
      padding: 4px 10px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5);
      z-index: 2;
    }
    .badge-live-tag {
      color: #ff3344;
      border: 1px solid rgba(255, 51, 68, 0.6);
    }
    .badge-upcoming-tag {
      color: var(--warn-yellow);
      border: 1px solid rgba(255, 183, 3, 0.6);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #ff3344;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 51, 68, 0.7); }
      70% { transform: scale(1.1); box-shadow: 0 0 0 7px rgba(255, 51, 68, 0); }
      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 51, 68, 0); }
    }

    .banner-wrapper {
      position: relative;
      width: 100%;
      height: 180px;
      background-color: #000;
    }
    .banner {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .content {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-res { background: rgba(0, 187, 255, 0.15); color: var(--res-blue); border: 1px solid var(--res-blue); }
    .badge-enl { background: rgba(0, 230, 118, 0.15); color: var(--enl-green); border: 1px solid var(--enl-green); }
    .badge-upcoming { background: rgba(255, 183, 3, 0.15); color: var(--warn-yellow); border: 1px solid var(--warn-yellow); }
    .title {
      font-size: 1.25rem;
      margin: 0 0 1.2rem 0;
    }
    .scores {
      display: flex;
      justify-content: space-between;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
    }
    .score-enl { color: var(--enl-green); font-weight: bold; }
    .score-res { color: var(--res-blue); font-weight: bold; }
    footer {
      text-align: center;
      margin-top: 4rem;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <a href="{{ t.switch_url }}" class="lang-btn">{{ t.switch_label }}</a>
  </div>

  <header>
    <h1>{{ t.hub_title }}</h1>
    <p style="color: var(--text-muted);">{{ t.hub_subtitle }}</p>
  </header>

  <!-- Bandeau palmarès global -->
  <section class="standings-banner">
    <div class="standings-title">{{ t.global_victories }}</div>
    <div class="standings-counts">
      <div class="faction-stat stat-enl">
        <span class="stat-num">{{ standings.enl_wins }}</span>
        <span class="stat-label">{{ t.victories_enl }} ({{ standings.enl_pct }}%)</span>
      </div>
      {% if standings.ties > 0 %}
      <div class="stat-tie">{{ standings.ties }} {{ t.ties }}</div>
      {% endif %}
      <div class="faction-stat stat-res">
        <span class="stat-label">({{ standings.res_pct }}%) {{ t.victories_res }}</span>
        <span class="stat-num">{{ standings.res_wins }}</span>
      </div>
    </div>
    <div class="ratio-bar">
      <div class="bar-segment-enl" style="width: {{ standings.enl_pct }}%;"></div>
      <div class="bar-segment-res" style="width: {{ standings.res_pct }}%;"></div>
    </div>
  </section>

  <main class="grid">
    {% for s in seasons %}
    <a href="{{ s.html_file }}" class="card card-{{ s.card_state }}">
      <div class="banner-wrapper">
        {% if s.card_state == 'live' %}
        <div class="banner-badge badge-live-tag">
          <div class="pulse-dot"></div>
          <span>{{ t.badge_live }}</span>
        </div>
        {% elif s.card_state == 'upcoming' %}
        <div class="banner-badge badge-upcoming-tag">
          <span>{{ t.badge_upcoming }}</span>
        </div>
        {% endif %}
        <img src="{{ s.banner }}" alt="{{ s.title }}" class="banner" onerror="this.src='https://placehold.co/600x300/141c2e/FFF?text=Anomaly'">
      </div>
      
      <div class="content">
        <div>
          <span class="badge {{ s.badge_class }}">{{ s.lead_badge }}</span>
          <h2 class="title">{{ s.title }}</h2>
        </div>
        <div class="scores">
          {% if s.card_state == 'upcoming' %}
          <div style="width: 100%; text-align: center; color: var(--text-muted);">{{ t.scores_pending }}</div>
          {% else %}
          <div>🟢 ENL : <span class="score-enl">{{ s.enl }}</span></div>
          <div>🔵 RES : <span class="score-res">{{ s.res }}</span></div>
          {% endif %}
        </div>
      </div>
    </a>
    {% endfor %}
  </main>

  <footer>
    {{ t.last_update }} <time id="last-update" datetime="{{ updated_at }}">{{ updated_at }}</time>
  </footer>

  <script>
    (function() {
      const timeElem = document.getElementById('last-update');
      if (timeElem && timeElem.dateTime) {
        const date = new Date(timeElem.dateTime);
        timeElem.textContent = date.toLocaleString('{{ t.lang_code }}', {
          dateStyle: 'short',
          timeStyle: 'medium'
        });
      }
    })();
  </script>

</body>
</html>
