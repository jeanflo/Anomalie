<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t.hub_title }}</title>
  <style>
    :root {
      --bg-dark: #090d16;
      --card-bg: #111827;
      --card-border: #1e293b;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --enl-color: #00ea62;
      --res-color: #00a2ff;
      --accent: #38bdf8;
    }
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.5;
    }
    .top-nav {
      max-width: 1200px;
      margin: 1rem auto 0;
      padding: 0 1.5rem;
      display: flex;
      justify-content: flex-end;
    }
    .nav-lang {
      color: var(--accent);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      padding: 0.25rem 0.75rem;
      border: 1px solid var(--card-border);
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.02);
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem;
    }
    header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    header h1 {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      letter-spacing: -0.5px;
    }
    header p {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin: 0;
    }
    .standings-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .standings-header {
      text-align: center;
      margin-bottom: 1.25rem;
    }
    .standings-header h2 {
      font-size: 1.2rem;
      margin: 0 0 0.5rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
    }
    .standings-counts {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      font-size: 1.25rem;
      font-weight: 700;
    }
    .count-enl { color: var(--enl-color); }
    .count-res { color: var(--res-color); }
    .count-tie { color: #cbd5e1; }
    .bar-container {
      width: 100%;
      height: 14px;
      background: #334155;
      border-radius: 999px;
      overflow: hidden;
      display: flex;
      margin-top: 1rem;
    }
    .bar-enl {
      background: var(--enl-color);
      height: 100%;
      transition: width 0.5s ease;
    }
    .bar-res {
      background: var(--res-color);
      height: 100%;
      transition: width 0.5s ease;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.75rem;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      position: relative;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: #334155;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    .card-live {
      border: 1px solid rgba(0, 162, 255, 0.4);
      box-shadow: 0 0 20px rgba(0, 162, 255, 0.15);
    }
    .card-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      background-color: #0b111e;
      border-bottom: 1px solid var(--card-border);
      display: block;
    }
    .badge-status {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    .badge-live {
      background: #ef4444;
      color: #fff;
      animation: pulse 2s infinite;
    }
    .badge-upcoming {
      background: #eab308;
      color: #000;
    }
    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.75; }
      100% { opacity: 1; }
    }
    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin: 0 0 0.75rem;
    }
    .lead-badge {
      display: inline-block;
      align-self: flex-start;
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }
    .badge-res {
      background: rgba(0, 162, 255, 0.15);
      color: var(--res-color);
      border: 1px solid rgba(0, 162, 255, 0.3);
    }
    .badge-enl {
      background: rgba(0, 234, 98, 0.15);
      color: var(--enl-color);
      border: 1px solid rgba(0, 234, 98, 0.3);
    }
    .scores {
      display: flex;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 0.95rem;
      font-weight: 600;
    }
    .score-enl { color: var(--enl-color); }
    .score-res { color: var(--res-color); }
    footer {
      text-align: center;
      margin: 3.5rem 0 2rem;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <div class="top-nav">
    <a class="nav-lang" href="{{ t.switch_url }}">{{ t.switch_label }}</a>
  </div>

  <main class="container">
    <header>
      <h1>{{ t.hub_title }}</h1>
      <p>{{ t.hub_subtitle }}</p>
    </header>

    <section class="standings-card">
      <div class="standings-header">
        <h2>{{ t.global_victories }}</h2>
        <div class="standings-counts">
          <span class="count-enl">{{ t.victories_enl }} : {{ standings.enl_wins }}</span>
          <span class="count-tie">{{ t.ties }} : {{ standings.ties }}</span>
          <span class="count-res">{{ t.victories_res }} : {{ standings.res_wins }}</span>
        </div>
      </div>
      <div class="bar-container">
        <div class="bar-enl" style="width: {{ standings.enl_pct }}%;"></div>
        <div class="bar-res" style="width: {{ standings.res_pct }}%;"></div>
      </div>
    </section>

    <div class="grid">
      {% for season in seasons %}
      <a class="card {% if season.card_state == 'live' %}card-live{% endif %}" href="{{ season.html_file }}">
        {% if season.card_state == 'live' %}
          <span class="badge-status badge-live">{{ t.badge_live }}</span>
        {% elif season.card_state == 'upcoming' %}
          <span class="badge-status badge-upcoming">{{ t.badge_upcoming }}</span>
        {% endif %}
        
        <img 
          class="card-img" 
          src="{{ season.banner }}" 
          alt="{{ season.title }}" 
          loading="lazy"
          onerror="this.onerror=null; this.src='https://placehold.co/1200x600/0f172a/38bdf8?text={{ season.slug | upper }}';">
        
        <div class="card-body">
          <h3 class="card-title">{{ season.title }}</h3>
          
          {% if season.lead_badge %}
            <span class="lead-badge {{ season.badge_class }}">{{ season.lead_badge }}</span>
          {% endif %}
          
          <div class="scores">
            <span class="score-enl">ENL : {{ season.enl }}</span>
            <span class="score-res">RES : {{ season.res }}</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>

    <footer>
      <p>{{ t.last_update }} : <time datetime="{{ updated_at }}">{{ updated_at }}</time></p>
    </footer>
  </main>
</body>
</html>
