<!DOCTYPE html>
<html lang="{{ t.lang_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t.hub_title }} — Ingress Anomaly Tracking</title>
  <link rel="stylesheet" href="/assets/style.css">
  <style>
    :root {
      --bg-dark: #0f141c;
      --card-bg: #141c28;
      --card-border: #223247;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --enl-color: #00ea62;
      --res-color: #00a2ff;
      --accent: #2dd4bf;
    }
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    .header {
      padding: 2.5rem 1.5rem 1.5rem;
      text-align: center;
      border-bottom: 1px solid var(--card-border);
      background: linear-gradient(180deg, #162235 0%, var(--bg-dark) 100%);
    }
    .header h1 {
      margin: 0 0 0.5rem;
      font-size: 2.2rem;
      letter-spacing: 1px;
      color: #fff;
    }
    .header p {
      color: var(--text-muted);
      margin: 0 0 1rem;
    }
    .update-meta {
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    .update-meta time, .update-meta strong {
      color: var(--text-main);
    }
    .lang-switcher {
      display: inline-block;
      margin-top: 0.75rem;
      padding: 0.35rem 0.8rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      color: var(--text-main);
      text-decoration: none;
      font-size: 0.85rem;
      transition: all 0.2s ease;
    }
    .lang-switcher:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--accent);
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .standings-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2.5rem;
      text-align: center;
    }
    .standings-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
    }
    .standings-bar {
      height: 14px;
      border-radius: 7px;
      background: #334155;
      display: flex;
      overflow: hidden;
      margin-bottom: 0.75rem;
    }
    .bar-enl {
      background: var(--enl-color);
      height: 100%;
    }
    .bar-res {
      background: var(--res-color);
      height: 100%;
    }
    .standings-stats {
      display: flex;
      justify-content: space-around;
      font-size: 0.95rem;
    }
    .stat-enl { color: var(--enl-color); font-weight: bold; }
    .stat-res { color: var(--res-color); font-weight: bold; }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.2s ease, border-color 0.2s ease;
      text-decoration: none;
      color: inherit;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: #38bdf8;
    }
    .card-live {
      border: 2px solid var(--res-color);
      box-shadow: 0 0 15px rgba(0, 162, 255, 0.2);
    }
    .card-upcoming {
      border: 1px dashed #eab308;
    }
    .card-banner {
      width: 100%;
      height: 150px;
      background-size: cover;
      background-position: center;
      background-color: #1e293b;
      position: relative;
    }
    .badge-status {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 4px 8px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .badge-live {
      background: #ef4444;
      color: #fff;
    }
    .badge-upcoming {
      background: #eab308;
      color: #000;
    }
    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-title {
      font-size: 1.25rem;
      margin: 0 0 0.75rem;
      font-weight: 600;
    }
    .card-lead {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      margin-bottom: 1rem;
      width: fit-content;
    }
    .badge-res { background: rgba(0, 162, 255, 0.15); color: var(--res-color); }
    .badge-enl { background: rgba(0, 234, 98, 0.15); color: var(--enl-color); }
    .card-scores {
      display: flex;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-weight: 600;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <header class="header">
    <h1>{{ t.hub_title }}</h1>
    <p>{{ t.hub_subtitle }}</p>
    <div class="update-meta">
      <span>{{ t.last_update }} : <time class="local-date" datetime="{{ updated_at }}">{{ updated_at }}</time></span>
      <span class="cron-next"> — Prochaine actualisation : <strong id="next-refresh">Calcul...</strong></span>
    </div>
    <div>
      <a class="lang-switcher" href="{{ t.switch_url }}">{{ t.switch_label }}</a>
    </div>
  </header>

  <main class="container">
    <section class="standings-panel">
      <div class="standings-title">{{ t.global_victories }}</div>
      <div class="standings-bar">
        <div class="bar-enl" style="width: {{ standings.enl_pct }}%;"></div>
        <div class="bar-res" style="width: {{ standings.res_pct }}%;"></div>
      </div>
      <div class="standings-stats">
        <div class="stat-enl">{{ t.victories_enl }} : {{ standings.enl_wins }} ({{ standings.enl_pct }}%)</div>
        <div class="stat-ties">{{ t.ties }} : {{ standings.ties }}</div>
        <div class="stat-res">{{ t.victories_res }} : {{ standings.res_wins }} ({{ standings.res_pct }}%)</div>
      </div>
    </section>

    <div class="cards-grid">
      {% for season in seasons %}
      <a class="card {% if season.card_state == 'live' %}card-live{% elif season.card_state == 'upcoming' %}card-upcoming{% endif %}" href="{{ season.html_file }}">
        <div class="card-banner" style="background-image: url('{{ season.banner }}');">
          {% if season.card_state == 'live' %}
            <span class="badge-status badge-live">{{ t.badge_live }}</span>
          {% elif season.card_state == 'upcoming' %}
            <span class="badge-status badge-upcoming">{{ t.badge_upcoming }}</span>
          {% endif %}
        </div>
        <div class="card-body">
          <h2 class="card-title">{{ season.title }}</h2>
          {% if season.lead_badge %}
            <div class="card-lead {{ season.badge_class }}">{{ season.lead_badge }}</div>
          {% endif %}
          <div class="card-scores">
            <span class="stat-enl">ENL : {{ season.enl }}</span>
            <span class="stat-res">RES : {{ season.res }}</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </main>

  <script>
    // Formatage des dates UTC générées vers l'heure locale
    document.querySelectorAll('.local-date').forEach(el => {
      const d = new Date(el.getAttribute('datetime'));
      if (!isNaN(d.getTime())) {
        el.textContent = d.toLocaleString([], {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
    });

    // Calcul de la prochaine exécution du cron job
    function getNextCronExecution() {
      const now = new Date();
      let candidates = [];

      for (let dayOffset = 0; dayOffset <= 8; dayOffset++) {
        const d = new Date(now.getTime());
        d.setUTCDate(d.getUTCDate() + dayOffset);
        const dayOfWeek = d.getUTCDay(); // 0 = Dimanche, 1 = Lundi, 6 = Samedi

        // Règle 1 : Lundi à 12:00 UTC
        if (dayOfWeek === 1) {
          const run = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), 12, 0, 0));
          if (run > now) candidates.push(run);
        }

        // Règle 2 : Samedi de 12:00 UTC à 23:30 UTC (toutes les 30 min)
        if (dayOfWeek === 6) {
          for (let h = 12; h <= 23; h++) {
            for (let m of [0, 30]) {
              const run = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m, 0));
              if (run > now) candidates.push(run);
            }
          }
        }

        // Règle 3 : Dimanche de 00:00 UTC à 12:00 UTC (toutes les 30 min)
        if (dayOfWeek === 0) {
          for (let h = 0; h <= 12; h++) {
            for (let m of [0, 30]) {
              if (h === 12 && m > 0) continue;
              const run = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m, 0));
              if (run > now) candidates.push(run);
            }
          }
        }
      }

      candidates.sort((a, b) => a - b);
      return candidates[0];
    }

    const nextRun = getNextCronExecution();
    const refreshEl = document.getElementById('next-refresh');
    if (refreshEl && nextRun) {
      refreshEl.textContent = nextRun.toLocaleString([], {
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit'
      });
    }
  </script>
</body>
</html>
